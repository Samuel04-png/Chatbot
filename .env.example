# Configuration names only. Copy to .env (gitignored) and fill locally. Never commit values.
# Run `.venv/bin/python scripts/check_secrets.py` before `git init` or any commit.

# --- Staff identity -----------------------------------------------------------
# Firebase stays the default until Supabase Auth passes staging verification.
# Server token verification: firebase | supabase | firebase,supabase (parallel run)
RUDO_IDENTITY_PROVIDERS=supabase
# Which sign-in pages the browser uses: firebase | supabase
RUDO_BROWSER_AUTH=supabase
FIREBASE_PROJECT_ID=dawa-ca263
# Path to a NEW, rotated service-account key file (gitignored). Never paste key contents anywhere.
# Leave blank: Firebase is read with your own Google login (gcloud auth application-default login), never a key file.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Supabase (browser-safe values) ---------------------------------------------
# Served to browsers via /api/auth-config. Must be a publishable (sb_publishable_) or anon-role key;
# the app refuses to start if a secret/service-role key is configured here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_GOOGLE_ENABLED=false
# Confirms each request's session still exists with Supabase Auth (sign-out/ban take effect). Keep true.
RUDO_SUPABASE_SESSION_CHECK=true

# --- Supabase (server/CLI only: never sent to a browser, never used by the web app) ---
# Used only by scripts/migrate_staff_auth.py and scripts/staff_admin.py.
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff auth migration (owner-run scripts only; delete after migration) ---
# From Firebase console > Authentication > Users > Password hash parameters.
FIREBASE_SIGNER_KEY=
FIREBASE_SALT_SEPARATOR=
FIREBASE_ROUNDS=8
FIREBASE_MEM_COST=14
# The only Supabase project ref the import may write to (set per run; staging first).
RUDO_AUTH_IMPORT_ALLOWED_REF=
# Owner connection to observer_control (links/approvals). Not the dashboard reader credential.
RUDO_CONTROL_ADMIN_DATABASE_URL=
# Firebase account migration ledger login (role rudo_migrator; see docs/auth-migration/FULL_MIGRATION.md)
RUDO_MIGRATOR_DATABASE_URL=
RUDO_MIGRATOR_ALLOW_REMOTE=false
RUDO_STAFF_ADMIN_ALLOW_REMOTE=false

# --- Production dashboard (Release 1) --------------------------------------------
# Set these in the HOSTING PLATFORM's secret settings, not in a file. Passwords for the three logins are
# generated at release time. Use the Supabase pooler and verified TLS, e.g.
# postgresql://rudo_observer.cktfbpnxpfbyroqzuibc:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/app/deploy/certs/prod-supabase.crt
RUDO_OBSERVER_ALLOW_REMOTE=false
RUDO_STAFF_ADMIN_DATABASE_URL=
# 32+ random characters, identical on every instance (signs pagination cursors).
RUDO_CURSOR_SECRET=
# Without a new (non-compromised) Firebase service-account key, set false: tokens are still fully verified;
# access is revoked by suspending staff in the Staff page.
RUDO_FIREBASE_CHECK_REVOKED=true
# true only behind the hosting platform's TLS load balancer.
RUDO_TRUST_PROXY=false

# --- Read-only observer (Option C) ----------------------------------------------
# Observer is the safe default; legacy private mode is explicitly selected only for its tests.
RUDO_MODE=observer
# Loopback by default; remote only with RUDO_OBSERVER_ALLOW_REMOTE=true and sslmode=verify-full.
RUDO_OBSERVER_DATABASE_URL=
RUDO_OBSERVER_AUDIT_DATABASE_URL=
RUDO_OBSERVER_SOURCE_ID=
RUDO_ALLOWED_ORIGIN=http://127.0.0.1:5000

# --- Legacy private mode (tests only) -------------------------------------------
# Dedicated non-BYPASSRLS login with membership in rudo_api, server only.
RUDO_DATABASE_URL=
# Separate restricted worker login with membership in rudo_worker.
RUDO_WORKER_DATABASE_URL=
# Remote writes intentionally blocked until separate approval.
RUDO_ENABLE_REMOTE_WRITES=false
RUDO_FACILITY_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Sending disabled until a separate staging/production integration approval.
RUDO_ENABLE_MESSAGE_DELIVERY=false
